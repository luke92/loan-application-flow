{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=loan_applications.db"
  },
  "ExternalService": {
    "BaseUrl": "http://localhost:4000"
  },
  "Blacklist": {
    "Ssns": ["999-99-9999", "888-88-8888"]
  },
  "Outbox": {
    "PollingIntervalSeconds": 5,
    "MaxAttempts": 5
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:3000"
  }
}
